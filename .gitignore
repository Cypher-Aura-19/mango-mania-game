# Dependencies
node_modules/

# Build output (built from src)
dist/

# Editor / OS
.idea/
.vscode/
*.swp
.DS_Store
npm-debug.log
yarn.lock

# Dev tooling / project working files
.superpowers/
.impeccable/
docs/

# Agent skill files, written into the repo by the Vercel marketplace integration
# when the Turso database was connected. Local tooling, not part of the game.
.agents/
.claude/
skills-lock.json

# Live score database. Player data, not source — and the -wal/-shm sidecars are
# mid-transaction state that means nothing outside the machine that wrote them.
data/
*.db
*.db-wal
*.db-shm
_server.log

# Screenshots and scratch output from the verification scripts in tools/.
# Regenerated on demand; nothing here is a source of truth.
.shots/

# Working copies kept while reworking the gameplay backdrops.
.bg-backup/
__pycache__/

# Vercel's local project link, and the env files `vercel env pull` writes into.
# .env.local holds the database URL and its auth token in plaintext: a live
# credential to the production leaderboard, never a thing to commit.
.vercel/
.env
.env.*

.vercel
.env*
